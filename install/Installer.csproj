<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <TargetFramework>net48</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <!--
        Pinned rather than floating: this project builds the MSIs users install, and the WiX
        toolchain is exactly the kind of dependency where a patch bump changes generated
        output. A lock file records the full graph.
    -->
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="WixSharp.bin" Version="1.26.0"/>
        <PackageReference Include="WixSharp.wix.bin" Version="3.14.1"/>
    </ItemGroup>

</Project>